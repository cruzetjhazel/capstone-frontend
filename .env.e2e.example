# Copy to .env.e2e (git-ignored) and fill in. Never commit real passwords.
E2E_REAL_API=true
VITE_API_URL=http://127.0.0.1:8000/api

E2E_CLIENT_EMAIL=client@example.test
E2E_CLIENT_PASSWORD=
E2E_OTHER_CLIENT_EMAIL=
E2E_OTHER_CLIENT_PASSWORD=
E2E_PHOTOGRAPHER_EMAIL=aurora-studios@example.test
E2E_PHOTOGRAPHER_PASSWORD=
E2E_PHOTOGRAPHER_ID=
E2E_ADMIN_EMAIL=admin@example.test
E2E_ADMIN_PASSWORD=

# Existing accounts whose emails pass the register form's email rule (only the email is used)
E2E_DUPLICATE_CLIENT_EMAIL=
E2E_DUPLICATE_PHOTOGRAPHER_EMAIL=

# Booking IDs: written for you by `php artisan e2e:seed-bookings --env=<path to this file>`
E2E_BOOKING_PENDING=
E2E_BOOKING_A=
E2E_BOOKING_B=
E2E_BOOKING_NOSHOW_BY_CLIENT=
E2E_BOOKING_NOSHOW_BY_PHOTOGRAPHER=
E2E_BOOKING_NOT_STARTED=
E2E_BOOKING_TOO_SOON=
E2E_BOOKING_ADMIN_UPHOLD=
E2E_BOOKING_ADMIN_DISPUTE=
E2E_BOOKING_ACCEPT=
E2E_BOOKING_LIFECYCLE=
E2E_BOOKING_COMPLETE=
